{
  "id": "web-search",
  "name": "Web Search",
  "version": "2.2.0",
  "author": "Rigelyon",
  "license": "MIT",
  "description": "Search the Internet from the Launcher.",
  "minNoctaliaVersion": "3.9.0",
  "repository": "https://github.com/bongdo/web-search",
  "tags": [
    "Launcher",
    "Utility"
  ],
  "entryPoints": {
    "main": "Main.qml",
    "launcherProvider": "LauncherProvider.qml",
    "settings": "Settings.qml"
  },
  "dependencies": {
    "plugins": []
  },
  "metadata": {
    "commandPrefix": "web",
    "defaultSettings": {
      "search_engine": "ddg",
      "direct_url": true,
      "show_suggestions": true,
      "favicons": true,
      "max_results": 8,
      "engines": [],
      "bookmarks": [],
      "shortcuts": [],
      "history": []
    }
  }
}
